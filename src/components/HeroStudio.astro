---
import { SITE } from '@/lib/site';

const chips = SITE.nav.filter((n) => n.href !== '/about' && n.href !== '/blog');
const primary = SITE.tagline;
const slogan = SITE.secondary;
---

<section class="hero-studio relative flex min-h-[calc(100dvh-3.75rem)] flex-col justify-center overflow-hidden px-[clamp(1.25rem,4vw,2rem)] py-16 sm:py-24">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-spotlight" id="hero-spotlight" aria-hidden="true"></div>

  <div class="relative z-[1] mx-auto w-full max-w-[58rem]">
    <p class="mb-7 font-[family-name:var(--font-mono)] text-[var(--text-micro)] uppercase tracking-[0.2em] text-[var(--color-fg-subtle)] animate-fade-up">
      Studio · AMAKEUR｜野造
    </p>

    <button
      type="button"
      id="hero-stage"
      class="group relative block w-full cursor-pointer border-0 bg-transparent p-0 text-left"
      aria-describedby="hero-secondary"
      aria-expanded="false"
      aria-label={primary}
    >
      <h1
        id="hero-line"
        class="hero-line font-[family-name:var(--font-display)] text-[clamp(2.5rem,10.5vw,6.25rem)] leading-[0.9] tracking-[-0.038em] text-[var(--color-fg)]"
        data-final={primary}
      >
        <span class="hero-ssr">{primary}</span>
      </h1>

      <p
        id="hero-secondary"
        class="hero-secondary mt-7 max-w-lg overflow-hidden font-[family-name:var(--font-sans)] text-[clamp(0.875rem,2.2vw,1rem)] leading-[1.45] tracking-[0.045em] text-[var(--color-fg-muted)]"
        data-line={slogan}
      >
        <span class="hero-sec-inner" id="hero-sec-inner"></span>
      </p>
    </button>

    <p class="mt-4 text-[11px] tracking-[0.02em] text-[var(--color-fg-subtle)] opacity-0 transition-opacity duration-[var(--duration-slow)]" id="hero-hint">
      Hover letters · click to reveal · or type <kbd class="font-[family-name:var(--font-mono)] text-[var(--color-accent)]">make</kbd>
    </p>

    <nav
      class="mt-16 flex flex-wrap items-center gap-2.5 sm:gap-3"
      aria-label="Studio sections"
      id="section-chips"
    >
      {chips.map((item, i) => (
        <a
          href={item.href}
          class="chip-label reveal"
          style={`transition-delay: ${120 + i * 60}ms`}
          data-astro-prefetch
          data-chip
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="mt-12 flex items-center gap-5 text-[var(--text-small)] tracking-[0.01em] text-[var(--color-fg-muted)]">
      <a href="/blog" class="underline-offset-4 hover:text-[var(--color-fg)] hover:underline" data-astro-prefetch>Blog</a>
      <span class="text-[var(--color-border-strong)]" aria-hidden="true">/</span>
      <a href="/about" class="underline-offset-4 hover:text-[var(--color-fg)] hover:underline" data-astro-prefetch>About</a>
    </div>
  </div>
</section>

<style>
  .hero-studio {
    --spot-x: 50%;
    --spot-y: 40%;
  }

  .hero-grid {
    position: absolute;
    inset: -10%;
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-border) 70%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-border) 70%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 42%, black 10%, transparent 72%);
    opacity: 0.4;
    animation: grid-drift 28s linear infinite;
    will-change: transform;
  }

  @keyframes grid-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-64px, -32px, 0); }
  }

  .hero-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--spot-x) var(--spot-y),
      color-mix(in oklab, var(--color-accent) 9%, transparent),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 280ms var(--ease-out-soft);
  }

  .hero-studio.is-lit .hero-spotlight {
    opacity: 1;
  }

  .hero-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    font-optical-sizing: auto;
    font-weight: 400;
  }

  .hero-char {
    display: inline-block;
    will-change: transform, opacity;
    transition: transform 180ms var(--ease-out-soft), color 180ms var(--ease-out-soft);
  }

  .hero-char.is-space {
    width: 0.28em;
  }

  .hero-char.is-accent {
    font-style: italic;
    font-weight: 450;
    color: var(--color-accent);
  }

  .hero-char.is-scrambling {
    color: var(--color-fg-subtle);
  }

  .hero-secondary {
    max-height: 0;
    opacity: 0;
    transition:
      max-height 360ms var(--ease-out-soft),
      opacity 300ms var(--ease-out-soft),
      margin 300ms var(--ease-out-soft);
  }

  .hero-secondary.is-open {
    max-height: 5rem;
    opacity: 1;
  }

  .hero-sec-inner .morph {
    display: inline-block;
    color: var(--color-accent);
    font-style: italic;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
  }

  #hero-hint.is-on {
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .hero-line {
      letter-spacing: -0.032em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid {
      animation: none;
    }
    .hero-char {
      transition: none;
    }
  }
</style>

<script is:inline src="/hero-studio.js" defer></script>
