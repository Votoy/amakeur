---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { CATEGORY_META, type ProjectCategory } from '@/lib/site';
import { getProjectsByCategory } from '@/lib/projects';

interface Props {
  category: ProjectCategory;
}

const { category } = Astro.props;
const meta = CATEGORY_META[category];
const projects = await getProjectsByCategory(category);
---
<BaseLayout title={meta.title} description={meta.description}>
  <div class="container-site section-pad">
    <SectionIntro title={meta.title} subtitle={meta.subtitle} description={meta.description} />
    {projects.length === 0 ? (
      <p class="text-[15px] text-[var(--color-fg-muted)]">Nothing here yet — check back soon.</p>
    ) : (
      <ul class={`catalog catalog--${category}`}>
        {projects.map((p, i) => (
          <ProjectRow
            index={i + 1}
            title={p.data.title}
            description={p.data.description}
            status={p.data.status}
            tags={p.data.tags}
            year={p.data.year}
            href={p.data.url}
          />
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
