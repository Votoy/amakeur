---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-[var(--color-border)]">
  <div class="container-site flex flex-col gap-6 py-10 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-2">
      <p class="text-sm font-medium tracking-tight">{SITE.name}</p>
      <p class="max-w-sm text-[13px] leading-relaxed text-[var(--color-fg-muted)]">
        {SITE.secondary}
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-[var(--color-fg-muted)]">
      <a href="/rss.xml" class="hover:text-[var(--color-fg)]">RSS</a>
      <a href="https://amakeur.com" class="hover:text-[var(--color-fg)]">amakeur.com</a>
      <span>© {year}</span>
    </div>
  </div>
</footer>
