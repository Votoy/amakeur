---
import { SITE } from '@/lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-[var(--color-border)]">
  <div class="container-site flex flex-col gap-7 py-12 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-2.5">
      <p class="text-[0.8125rem] font-medium tracking-[0.04em]">{SITE.name}</p>
      <p class="lockup max-w-sm">
        {SITE.secondary}
      </p>
      <p
        id="studio-wit"
        class="max-w-sm font-[family-name:var(--font-mono)] text-[var(--text-micro)] tracking-[0.04em] text-[var(--color-fg-subtle)]"
        aria-live="polite"
      ></p>
    </div>
    <div class="flex flex-col items-start gap-3 sm:items-end">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[var(--text-small)] text-[var(--color-fg-muted)]">
        <a href="/rss.xml" class="hover:text-[var(--color-accent)]">RSS</a>
        <a href="https://amakeur.com" class="hover:text-[var(--color-accent)]" rel="noopener noreferrer">amakeur.com</a>
        <span class="font-[family-name:var(--font-mono)] text-[var(--text-micro)] tracking-[0.06em]">© {year}</span>
      </div>
      <div class="flex items-center gap-3 font-[family-name:var(--font-mono)] text-[10px] tracking-[0.08em] text-[var(--color-fg-subtle)]">
        <time id="studio-clock" class="tabular-nums" datetime="" title="Local time">--:--:--</time>
        <span aria-hidden="true">·</span>
        <span id="studio-built" class="tabular-nums">built —</span>
      </div>
    </div>
  </div>
</footer>
