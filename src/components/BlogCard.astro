---
import { formatDate } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  readingMinutes?: number;
  tags?: string[];
}

const { title, description, href, pubDate, readingMinutes, tags = [] } = Astro.props;
---
<li class="reveal">
  <a href={href} class="editorial-item group" data-astro-prefetch>
    <time class="editorial-date" datetime={pubDate.toISOString()}>
      {formatDate(pubDate)}
    </time>
    <div>
      <h3 class="editorial-title">{title}</h3>
      <p class="editorial-dek">{description}</p>
      <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-[var(--color-fg-subtle)]">
        {readingMinutes && <span>{readingMinutes} min</span>}
        {tags.slice(0, 3).map((tag) => (
          <span>#{tag}</span>
        ))}
      </div>
    </div>
  </a>
</li>
