---
import { formatDate } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  readingMinutes?: number;
  tags?: string[];
}

const { title, description, href, pubDate, readingMinutes, tags = [] } = Astro.props;
---
<a
  href={href}
  class="card-lift group block rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-5"
  data-astro-prefetch
>
  <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-[var(--color-fg-subtle)]">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {readingMinutes && (
      <>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min</span>
      </>
    )}
  </div>
  <h3 class="mb-1.5 text-[16px] font-medium tracking-tight">{title}</h3>
  <p class="text-[13px] leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <li class="text-[11px] text-[var(--color-fg-subtle)]">#{tag}</li>
      ))}
    </ul>
  )}
</a>
