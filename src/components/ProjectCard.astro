---
import ProjectRow from './ProjectRow.astro';

interface Props {
  title: string;
  description: string;
  status: 'shipping' | 'experiment' | 'archived' | 'concept';
  tags?: string[];
  year?: number;
  href?: string;
  index?: number;
}

const { title, description, status, tags = [], year, href, index = 1 } = Astro.props;
---
<ProjectRow
  index={index}
  title={title}
  description={description}
  status={status}
  tags={tags}
  year={year}
  href={href}
/>
