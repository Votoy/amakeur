---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}
const { title, subtitle, description } = Astro.props;
---
<header class="mb-10 max-w-2xl animate-fade-up">
  <p class="mb-2 text-[12px] font-medium uppercase tracking-[0.12em] text-[var(--color-fg-subtle)]">
    AMAKEUR / {title}
  </p>
  <h1 class="font-[family-name:var(--font-display)] text-4xl tracking-[-0.03em] text-[var(--color-fg)] sm:text-5xl">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-3 text-lg text-[var(--color-fg-muted)]">{subtitle}</p>
  )}
  {description && (
    <p class="mt-4 text-[15px] leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
  )}
</header>
