---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  indexLabel?: string;
}
const { title, subtitle, description, indexLabel } = Astro.props;
---
<header class="mb-12 max-w-2xl animate-fade-up">
  <p class="mb-3 font-[family-name:var(--font-mono)] text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-fg-subtle)]">
    {indexLabel ?? `AMAKEUR / ${title}`}
  </p>
  <h1 class="font-[family-name:var(--font-display)] text-[clamp(2.75rem,7vw,4.25rem)] leading-[0.95] tracking-[-0.04em] text-[var(--color-fg)]">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-4 text-lg italic text-[var(--color-fg-muted)] font-[family-name:var(--font-display)]">
      {subtitle}
    </p>
  )}
  {description && (
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-[var(--color-fg-muted)]">{description}</p>
  )}
  <hr class="rule-accent mt-8 max-w-[4rem]" />
</header>
